DATABASE_URL=postgresql://app:app@localhost:5432/it_equipment
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1h
API_PORT=3001
API_URL=http://localhost:3001/api/v1
COOKIE_SECURE=false
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=it_equipment
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_EMAIL=10
LOGIN_MAX_FAILURES_PER_IP=50
# Set TRUST_PROXY ONLY when a trusted reverse proxy in front of the web app adds X-Forwarded-For (it enables the per-IP login limit).
# Leave it unset for local dev and the plain docker compose stack; the per-email limit always works.
# TRUST_PROXY=loopback, linklocal, uniquelocal

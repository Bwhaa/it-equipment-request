{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "dotenv -e .env.test -- jest --config ./test/jest-e2e.json --runInBand",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "dotenv-cli": "8.0.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
